# Maintainer: SkrinVex <dev@skrinvex.dev>
pkgname=gitora
pkgver=1.0.0
pkgrel=1
pkgdesc="Powerful Git. Beautifully Simple. Modern desktop Git client built with Flutter."
arch=('x86_64')
url="https://github.com/skrinvex/gitora"
license=('MIT')
depends=('gtk3' 'git')
optdepends=('libgit2: Fast direct git repository backend')
makedepends=('flutter')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  flutter config --no-analytics
  flutter pub get
  flutter build linux --release
}

package() {
  cd "$pkgname-$pkgver"
  
  install -d "$pkgdir/usr/lib/$pkgname"
  cp -r build/linux/x64/release/bundle/* "$pkgdir/usr/lib/$pkgname/"

  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/gitora" "$pkgdir/usr/bin/gitora"

  install -Dm644 linux/packaging/dev.skrinvex.gitora.desktop "$pkgdir/usr/share/applications/dev.skrinvex.gitora.desktop"
  install -Dm644 linux/packaging/dev.skrinvex.gitora.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/dev.skrinvex.gitora.png"
  install -Dm644 linux/packaging/dev.skrinvex.gitora.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.skrinvex.gitora.svg"
}
